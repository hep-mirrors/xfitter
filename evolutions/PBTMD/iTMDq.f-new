      Function iTMDq(xt)

      Implicit None

      Double Precision iTMDq
      Double Precision xt

      Integer i

      Double Precision xr,pr
      Double Precision x0,xmin,xmax,wt
      Double Precision invx0
      Double Precision test

      Double Precision sumd,sumu,sumdb,sumub
      Double Precision sumall

      Double Precision x,q2,xkt
      Integer iparton

      Common /myvalues/x,q2,xkt,iparton

      Double Precision xpqr(-6:11),xpqru(-6:11)
      Double Precision xpqrc(-6:11),xpqrb(-6:11)
      Double Precision xpqrdbar(-6:11),xpqrubar(-6:11)
      Double Precision xpqrtest(-6:11)

      Double Precision xpq0(-6:11)

      Double Precision qstart,xstart

      Double Precision A(-6:6,6)
      Double Precision Ab(-6:6,6)

      Character mygridfiles_d*132
      Character mygridfiles_u*132
      Character mygridfiles_ubar*132
      Character mygridfiles_dbar*132
      Character mygridfiles_c*132
      Character mygridfiles_b*132

      Common/ myfiles/ mygridfiles_d, mygridfiles_u, mygridfiles_ubar, mygridfiles_dbar,mygridfiles_c, mygridfiles_b

c-----------------------------------------------------------------------
c kinematics
c-----------------------------------------------------------------------

      pr = sqrt(q2)

      xmin = x
      xmax = 0.9999999999d0

      wt = log(xmax/xmin)

      x0 = xmin*(xmax/xmin)**xt

      invx0 = 1d0/x0

      xr = x/x0

c-----------------------------------------------------------------------
c DO NOT initialize arrays here
c IMPORTANT:
c original code relies on exact memory behavior
c-----------------------------------------------------------------------

c-----------------------------------------------------------------------
c load grids
c-----------------------------------------------------------------------

      if(xkt.lt.0d0) then

        if(mygridfiles_c.ne.' ') then

          call iTMDgridq_c(xr,pr,xpqrc)
          call iTMDgridq_b(xr,pr,xpqrb)
        endif


        if(mygridfiles_u.ne.' ') then

          call iTMDgridq_d(xr,pr,xpqr)
          call iTMDgridq_u(xr,pr,xpqru)

          if(mygridfiles_ubar.ne.' ') then

            call iTMDgridq_dbar(xr,pr,xpqrdbar)
            call iTMDgridq_ubar(xr,pr,xpqrubar)

          else

            do i=-6,11
              xpqrdbar(-i)=xpqr(i)
              xpqrubar(-i)=xpqru(i)
            enddo

          endif

        else

          call iTMDgridq(xr,pr,xpqrtest)

c-----------------------------------------------------------------------
c EXACT original reconstruction
c-----------------------------------------------------------------------

          xpqr(0)=xpqrtest(0)

          xpqr(1)=xpqrtest(-3)
          xpqr(2)=0.5d0*(xpqrtest(-2)+xpqrtest(-1))
          xpqr(3)=0.5d0*(xpqrtest(-2)+xpqrtest(-1))

          xpqr(-1)=xpqrtest(3)
          xpqr(-2)=0.5d0*(xpqrtest(2)+xpqrtest(1))
          xpqr(-3)=0.5d0*(xpqrtest(2)+xpqrtest(1))

          xpqru(1)=0.5d0*(xpqrtest(-2)+xpqrtest(-1))
          xpqru(2)=xpqrtest(-3)
          xpqru(3)=0.5d0*(xpqrtest(-2)+xpqrtest(-1))

          xpqru(-1)=0.5d0*(xpqrtest(2)+xpqrtest(1))
          xpqru(-2)=xpqrtest(3)
          xpqru(-3)=0.5d0*(xpqrtest(2)+xpqrtest(1))

          xpqr(4)=xpqrtest(-4)
          xpqr(5)=xpqrtest(-5)

          xpqr(-4)=xpqrtest(4)
          xpqr(-5)=xpqrtest(5)

          xpqru(4)=xpqrtest(-4)
          xpqru(5)=xpqrtest(-5)

          xpqru(-4)=xpqrtest(4)
          xpqru(-5)=xpqrtest(5)

          xpqrdbar(1)=xpqrtest(3)
          xpqrdbar(2)=0.5d0*(xpqrtest(2)+xpqrtest(1))
          xpqrdbar(3)=0.5d0*(xpqrtest(2)+xpqrtest(1))

          xpqrdbar(-1)=xpqrtest(-3)
          xpqrdbar(-2)=0.5d0*(xpqrtest(-2)+xpqrtest(-1))
          xpqrdbar(-3)=0.5d0*(xpqrtest(-2)+xpqrtest(-1))

          xpqrubar(1)=0.5d0*(xpqrtest(2)+xpqrtest(1))
          xpqrubar(2)=xpqrtest(3)
          xpqrubar(3)=0.5d0*(xpqrtest(2)+xpqrtest(1))

          xpqrubar(-1)=0.5d0*(xpqrtest(-2)+xpqrtest(-1))
          xpqrubar(-2)=xpqrtest(-3)
          xpqrubar(-3)=0.5d0*(xpqrtest(-2)+xpqrtest(-1))

          xpqrdbar(4)=xpqrtest(4)
          xpqrdbar(5)=xpqrtest(5)

          xpqrdbar(-4)=xpqrtest(-4)
          xpqrdbar(-5)=xpqrtest(-5)

          xpqrubar(4)=xpqrtest(4)
          xpqrubar(5)=xpqrtest(5)

          xpqrubar(-4)=xpqrtest(-4)
          xpqrubar(-5)=xpqrtest(-5)

        endif

      else

        if(mygridfiles_u.ne.' ') then

          call TMDgridq(xr,xkt,pr,xpqr)
          call TMDgridq_u(xr,xkt,pr,xpqru)

          do i=-6,11
            xpqrdbar(-i)=xpqr(i)
            xpqrubar(-i)=xpqru(i)
          enddo

        endif

      endif

c-----------------------------------------------------------------------
c EXACT original matrix structure
c-----------------------------------------------------------------------

      call BuildFlavorMatrices(A,Ab,
     &                         xpqr,xpqru,
     &                         xpqrdbar,xpqrubar,
     &                         xpqrc,xpqrb)

c-----------------------------------------------------------------------
c starting distributions
c-----------------------------------------------------------------------

      xstart = x0

      call TMDstart(xstart,qstart,xpq0)

c-----------------------------------------------------------------------
c reusable sums
c preserve original summation ordering
c-----------------------------------------------------------------------

cc      sumd  = xpq0(1)+xpq0(3)+xpq0(5)
cc      sumu  = xpq0(2)+xpq0(4)+xpq0(6)

cc      sumdb = xpq0(-1)+xpq0(-3)+xpq0(-5)
cc      sumub = xpq0(-2)+xpq0(-4)+xpq0(-6)

      sumd  = xpq0(1)+xpq0(3) 
      sumu  = xpq0(2) 

      sumdb = xpq0(-1)+xpq0(-3) 
      sumub = xpq0(-2) 

      sumall =
     & xpq0(1)+xpq0(2)+xpq0(3)+xpq0(4)
     &+xpq0(-1)+xpq0(-2)+xpq0(-3)+xpq0(-4)

c-----------------------------------------------------------------------
c convolution
c-----------------------------------------------------------------------

      test = 0d0

      if(iparton.eq.0) then

c        test =
c     &  xpqr(0)*sumall
        test = xpqr(0)*sumd + xpqru(0)*sumu + xpqrdbar(0)*sumdb + xpqrubar(0)*sumub
cccc     &        +  xpqrc(0)*(xpq0(4)+xpq0(-4)) +  xpqrb(0)*(xpq0(5)+xpq0(-5))

        test = test*invx0

      elseif(abs(iparton).le.6) then

        do i=1,5

          test =
     &    test
     &   +A(iparton,i)*xpq0(i)
     &   +Ab(iparton,i)*xpq0(-i)

        enddo

        test = test*invx0

      elseif(iparton.ge.7.and.iparton.le.8) then

        test =
     &   xpqr(iparton)*sumd
     &  +xpqru(iparton)*sumu
     &  +xpqrdbar(iparton)*sumdb
     &  +xpqrubar(iparton)*sumub

        test = test*invx0

      elseif(iparton.eq.9) then

        test =
     &   xpqru(iparton)*xpq0(2)
     &  +xpqrdbar(iparton)*xpq0(-1)
     &  +xpqrdbar(iparton)*xpq0(-3)

        test = test*invx0

      elseif(iparton.eq.10) then

        test =
     &   xpqr(iparton)*xpq0(1)
     &  +xpqr(iparton)*xpq0(3)
     &  +xpqrubar(iparton)*xpq0(-2)

        test = test*invx0

      elseif(iparton.eq.11) then

        test =
     &   xpqr(iparton)
     &  *(xpq0(1)+xpq0(3)+xpq0(-1)+xpq0(-3))
     &  +xpqru(iparton)
     &  *(xpq0(2)+xpq0(-2))

        test = test*invx0

      endif

      iTMDq = test*wt*x0

      return
      end
      
      
      Subroutine BuildFlavorMatrices(A,Ab,
     &                               xpqr,xpqru,
     &                               xpqrdbar,xpqrubar,
     &                               xpqrc,xpqrb)


      Implicit None

      Integer i,j

      Double Precision A(-6:6,6)
      Double Precision Ab(-6:6,6)

      Double Precision xpqr(-6:11),xpqru(-6:11)
      Double Precision xpqrc(-6:11),xpqrb(-6:11)
      Double Precision xpqrdbar(-6:11),xpqrubar(-6:11)
      
      Integer ItestCB/1/

c-----------------------------------------------------------------------
c IMPORTANT:
c preserve EXACT original matrix structure
c-----------------------------------------------------------------------

      do i=-6,6
        do j=1,6
          A(i,j)=0d0
          Ab(i,j)=0d0
        enddo
      enddo

c=======================================================================
c quarks
c=======================================================================

      A(1,1)=xpqr(1)
      A(1,2)=xpqru(1)
      A(1,3)=xpqr(3)
      A(1,4)=xpqru(3)
      A(1,5)=xpqr(3)
      A(1,6)=xpqru(3)

      A(2,1)=xpqr(2)
      A(2,2)=xpqru(2)
      A(2,3)=xpqr(3)
      A(2,4)=xpqru(3)
      A(2,5)=xpqr(3)
      A(2,6)=xpqru(3)

      A(3,1)=xpqr(3)
      A(3,2)=xpqru(3)
      A(3,3)=xpqr(1)
      A(3,4)=xpqru(3)
      A(3,5)=xpqr(3)
      A(3,6)=xpqru(3)

      A(4,1)=xpqr(4)
      A(4,2)=xpqru(4)
      A(4,3)=xpqr(4)
      A(4,4)=xpqru(2)
      A(4,5)=xpqr(4)
      A(4,6)=xpqru(4)

      A(5,1)=xpqr(5)
      A(5,2)=xpqru(5)
      A(5,3)=xpqr(5)
      A(5,4)=xpqru(5)
      A(5,5)=xpqr(1)
      A(5,6)=xpqru(5)

      A(6,1)=xpqr(6)
      A(6,2)=xpqru(6)
      A(6,3)=xpqr(6)
      A(6,4)=xpqru(6)
      A(6,5)=xpqr(6)
      A(6,6)=xpqru(2)

      if(ItestCB.eq.1) then      
c new for charm and botom densities
c-----------------------------------------------------------------------
c incoming charm
c-----------------------------------------------------------------------

      A(1,4)=xpqrc(1)
      A(2,4)=xpqrc(2)
      A(3,4)=xpqrc(3)
      A(4,4)=xpqrc(4)
      A(5,4)=xpqrc(5)
      A(6,4)=xpqrc(6)

c-----------------------------------------------------------------------
c incoming bottom
c-----------------------------------------------------------------------

      A(1,5)=xpqrb(1)
      A(2,5)=xpqrb(2)
      A(3,5)=xpqrb(3)
      A(4,5)=xpqrb(4)
      A(5,5)=xpqrb(5)
      A(6,5)=xpqrb(6)      
c      A(1,5)=0
c      A(2,5)=0
c      A(3,5)=0
c      A(4,5)=0
c      A(5,5)=0
c      A(6,5)=0      
      endif      

c=======================================================================
c antiquarks
c=======================================================================

      A(-1,1)=xpqr(-1)
      A(-1,2)=xpqru(-1)
      A(-1,3)=xpqr(-3)
      A(-1,4)=xpqru(-3)
      A(-1,5)=xpqr(-3)
      A(-1,6)=xpqru(-3)

      A(-2,1)=xpqr(-2)
      A(-2,2)=xpqru(-2)
      A(-2,3)=xpqr(-3)
      A(-2,4)=xpqru(-3)
      A(-2,5)=xpqr(-3)
      A(-2,6)=xpqru(-3)

      A(-3,1)=xpqr(-3)
      A(-3,2)=xpqru(-3)
      A(-3,3)=xpqr(-1)
      A(-3,4)=xpqru(-3)
      A(-3,5)=xpqr(-3)
      A(-3,6)=xpqru(-3)

      A(-4,1)=xpqr(-4)
      A(-4,2)=xpqru(-4)
      A(-4,3)=xpqr(-4)
      A(-4,4)=xpqru(-2)
      A(-4,5)=xpqr(-4)
      A(-4,6)=xpqru(-4)

      A(-5,1)=xpqr(-5)
      A(-5,2)=xpqru(-5)
      A(-5,3)=xpqr(-5)
      A(-5,4)=xpqru(-5)
      A(-5,5)=xpqr(-1)
      A(-5,6)=xpqru(-5)

      A(-6,1)=xpqr(-6)
      A(-6,2)=xpqru(-6)
      A(-6,3)=xpqr(-6)
      A(-6,4)=xpqru(-6)
      A(-6,5)=xpqr(-6)
      A(-6,6)=xpqru(-2)

      if(ItestCB.eq.1) then
c new for charm and botom densities
c-----------------------------------------------------------------------
c incoming charm
c-----------------------------------------------------------------------

      A(-1,4)=xpqrc(-1)
      A(-2,4)=xpqrc(-2)
      A(-3,4)=xpqrc(-3)
      A(-4,4)=xpqrc(-4)
      A(-5,4)=xpqrc(-5)
      A(-6,4)=xpqrc(-6)

c-----------------------------------------------------------------------
c incoming bottom
c-----------------------------------------------------------------------

      A(-1,5)=xpqrb(-1)
      A(-2,5)=xpqrb(-2)
      A(-3,5)=xpqrb(-3)
      A(-4,5)=xpqrb(-4)
      A(-5,5)=xpqrb(-5)
      A(-6,5)=xpqrb(-6)      
c      A(-1,5)=0
c      A(-2,5)=0
c      A(-3,5)=0
c      A(-4,5)=0
c      A(-5,5)=0
c      A(-6,5)=0      
      endif      


c=======================================================================
c anti-quark kernels
c=======================================================================

      Ab(1,1)=xpqrdbar(1)
      Ab(1,2)=xpqrubar(1)
      Ab(1,3)=xpqrdbar(3)
      Ab(1,4)=xpqrubar(3)
      Ab(1,5)=xpqrdbar(3)
      Ab(1,6)=xpqrubar(3)

      Ab(2,1)=xpqrdbar(2)
      Ab(2,2)=xpqrubar(2)
      Ab(2,3)=xpqrdbar(3)
      Ab(2,4)=xpqrubar(3)
      Ab(2,5)=xpqrdbar(3)
      Ab(2,6)=xpqrubar(3)

      Ab(3,1)=xpqrdbar(3)
      Ab(3,2)=xpqrubar(3)
      Ab(3,3)=xpqrdbar(1)
      Ab(3,4)=xpqrubar(3)
      Ab(3,5)=xpqrdbar(3)
      Ab(3,6)=xpqrubar(3)

      Ab(4,1)=xpqrdbar(4)
      Ab(4,2)=xpqrubar(4)
      Ab(4,3)=xpqrdbar(4)
      Ab(4,4)=xpqrubar(2)
      Ab(4,5)=xpqrdbar(4)
      Ab(4,6)=xpqrubar(4)

      Ab(5,1)=xpqrdbar(5)
      Ab(5,2)=xpqrubar(5)
      Ab(5,3)=xpqrdbar(5)
      Ab(5,4)=xpqrubar(5)
      Ab(5,5)=xpqrdbar(1)
      Ab(5,6)=xpqrubar(5)

      Ab(6,1)=xpqrdbar(6)
      Ab(6,2)=xpqrubar(6)
      Ab(6,3)=xpqrdbar(6)
      Ab(6,4)=xpqrubar(6)
      Ab(6,5)=xpqrdbar(6)
      Ab(6,6)=xpqrubar(2)

      if(ItestCB.eq.1) then
c new for charm and botom densities
c-----------------------------------------------------------------------
c incoming charm
c-----------------------------------------------------------------------

      Ab(1,4)=xpqrc(1)
      Ab(2,4)=xpqrc(2)
      Ab(3,4)=xpqrc(3)
      Ab(4,4)=xpqrc(4)
      Ab(5,4)=xpqrc(5)
      Ab(6,4)=xpqrc(6)
c      Ab(1,4)=0
c      Ab(2,4)=0
c      Ab(3,4)=0
c      Ab(4,4)=0
c      Ab(5,4)=0
c      Ab(6,4)=0      

c-----------------------------------------------------------------------
c incoming bottom
c-----------------------------------------------------------------------

      Ab(1,5)=xpqrb(1)
      Ab(2,5)=xpqrb(2)
      Ab(3,5)=xpqrb(3)
      Ab(4,5)=xpqrb(4)
      Ab(5,5)=xpqrb(5)
      Ab(6,5)=xpqrb(6)      
c      Ab(1,5)=0
c      Ab(2,5)=0
c      Ab(3,5)=0
c      Ab(4,5)=0
c      Ab(5,5)=0
c      Ab(6,5)=0      
      endif      


c=======================================================================
c anti-particle entries
c=======================================================================

      Ab(-1,1)=xpqrdbar(-1)
      Ab(-1,2)=xpqrubar(-1)
      Ab(-1,3)=xpqrdbar(-3)
      Ab(-1,4)=xpqrubar(-3)
      Ab(-1,5)=xpqrdbar(-3)
      Ab(-1,6)=xpqrubar(-3)

      Ab(-2,1)=xpqrdbar(-2)
      Ab(-2,2)=xpqrubar(-2)
      Ab(-2,3)=xpqrdbar(-3)
      Ab(-2,4)=xpqrubar(-3)
      Ab(-2,5)=xpqrdbar(-3)
      Ab(-2,6)=xpqrubar(-3)

      Ab(-3,1)=xpqrdbar(-3)
      Ab(-3,2)=xpqrubar(-3)
      Ab(-3,3)=xpqrdbar(-1)
      Ab(-3,4)=xpqrubar(-3)
      Ab(-3,5)=xpqrdbar(-3)
      Ab(-3,6)=xpqrubar(-3)

      Ab(-4,1)=xpqrdbar(-4)
      Ab(-4,2)=xpqrubar(-4)
      Ab(-4,3)=xpqrdbar(-4)
      Ab(-4,4)=xpqrubar(-2)
      Ab(-4,5)=xpqrdbar(-4)
      Ab(-4,6)=xpqrubar(-4)

      Ab(-5,1)=xpqrdbar(-5)
      Ab(-5,2)=xpqrubar(-5)
      Ab(-5,3)=xpqrdbar(-5)
      Ab(-5,4)=xpqrubar(-5)
      Ab(-5,5)=xpqrdbar(-1)
      Ab(-5,6)=xpqrubar(-5)

      Ab(-6,1)=xpqrdbar(-6)
      Ab(-6,2)=xpqrubar(-6)
      Ab(-6,3)=xpqrdbar(-6)
      Ab(-6,4)=xpqrubar(-6)
      Ab(-6,5)=xpqrdbar(-6)
      Ab(-6,6)=xpqrubar(-2)

      if(ItestCB.eq.1) then
c new for charm and botom densities
c-----------------------------------------------------------------------
c incoming charm
c-----------------------------------------------------------------------

      Ab(-1,4)=xpqrc(-1)
      Ab(-2,4)=xpqrc(-2)
      Ab(-3,4)=xpqrc(-3)
      Ab(-4,4)=xpqrc(-4)
      Ab(-5,4)=xpqrc(-5)
      Ab(-6,4)=xpqrc(-6)
c      Ab(-1,4)=0
c      Ab(-2,4)=0
c      Ab(-3,4)=0
c      Ab(-4,4)=0
c      Ab(-5,4)=0
c      Ab(-6,4)=0      

c-----------------------------------------------------------------------
c incoming bottom
c-----------------------------------------------------------------------

      Ab(-1,5)=xpqrb(-1)
      Ab(-2,5)=xpqrb(-2)
      Ab(-3,5)=xpqrb(-3)
      Ab(-4,5)=xpqrb(-4)
      Ab(-5,5)=xpqrb(-5)
      Ab(-6,5)=xpqrb(-6)      
c      Ab(-1,5)=0
c      Ab(-2,5)=0
c      Ab(-3,5)=0
c      Ab(-4,5)=0
c      Ab(-5,5)=0
c      Ab(-6,5)=0      
      endif      

      return
      end
            